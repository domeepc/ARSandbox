# SARndbox / Vrui build artifacts
sarndbox/o/
sarndbox/bin/
sarndbox/d/
*.o
*.so
*.so.*

# Qt / CMake build output
control-panel/build/

# Projector calibration is measured output, not source. It is specific to the
# exact physical placement of the projector and is regenerated by
# CalibrateProjector whenever the rig is moved, so a committed copy would only
# ever be stale and misleading.
config/ProjectorMatrix.dat
sarndbox/etc/SARndbox-2.8/ProjectorMatrix.dat

# Calibration backups written by the sandbox when it rewrites a layout
*.bak
*.save
